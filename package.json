{
	"name": "n8n-nodes-meetstream",
	"version": "0.1.0",
	"description": "Use MeetStream meeting bots in n8n workflows",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"homepage": "https://meetstream.ai",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "MeetStream",
		"email": "support@meetstream.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Arjun220905/n8n-nodes-meetstream.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"test": "npm run build && node --test",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MeetStreamApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MeetStream/MeetStream.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.49.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
