{
	"name": "MeetStream — Post-call transcript to LLM starter",
	"nodes": [
		{
			"parameters": {},
			"id": "transcript-input",
			"name": "Transcript input",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [260, 300]
		},
		{
			"parameters": {
				"mode": "raw",
				"jsonOutput": "{\n  \"bot_id\": \"replace-with-a-post-call-bot-id\"\n}"
			},
			"id": "set-bot-id",
			"name": "Set post-call bot ID",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [480, 300]
		},
		{
			"parameters": {
				"resource": "bot",
				"operation": "getTranscriptions",
				"botId": "={{$json.bot_id}}"
			},
			"id": "meetstream-transcriptions",
			"name": "MeetStream: Get transcriptions",
			"type": "n8n-nodes-meetstream.meetStream",
			"typeVersion": 1,
			"position": [720, 300]
		},
		{
			"parameters": {
				"resource": "transcript",
				"operation": "getTranscript",
				"transcriptId": "={{$json.transcriptions[0].transcript_id}}"
			},
			"id": "meetstream-transcript",
			"name": "MeetStream: Get transcript",
			"type": "n8n-nodes-meetstream.meetStream",
			"typeVersion": 1,
			"position": [960, 300]
		},
		{
			"parameters": {},
			"id": "llm-handoff",
			"name": "LLM summarisation (configure)",
			"type": "n8n-nodes-base.noOp",
			"typeVersion": 1,
			"position": [1200, 300]
		}
	],
	"connections": {
		"Transcript input": { "main": [[{ "node": "Set post-call bot ID", "type": "main", "index": 0 }]] },
		"Set post-call bot ID": {
			"main": [[{ "node": "MeetStream: Get transcriptions", "type": "main", "index": 0 }]]
		},
		"MeetStream: Get transcriptions": {
			"main": [[{ "node": "MeetStream: Get transcript", "type": "main", "index": 0 }]]
		},
		"MeetStream: Get transcript": {
			"main": [[{ "node": "LLM summarisation (configure)", "type": "main", "index": 0 }]]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" },
	"meta": { "templateCredsSetupCompleted": false }
}
