{
  "name": "MeetStream — Summarize live transcript turns with OpenAI",
  "nodes": [
    {
      "parameters": {
        "content": "## START HERE — 5 steps\n1. Open **Create live transcription bot** → Credential → **Create New Credential**. Paste the API key from `app.meetstream.ai/api-key`, test it, and save.\n2. Open **Summarize live turn** and connect OpenAI (or n8n Gateway credits when available).\n3. Activate this workflow, then copy the live webhook's **Production URL**.\n4. Paste that URL and a meeting you own into **Configure meeting and production webhook**. The URL must be public HTTPS; localhost needs a tunnel.\n5. Execute the manual branch once to send the bot.\n\nOnly final speaker turns reach OpenAI. Credentials are intentionally never stored in templates. Rate-limit and verify public webhooks at a gateway.",
        "height": 410,
        "width": 720
      },
      "id": "ecae655c-129d-46ae-b02c-9f34897f26cf",
      "name": "START HERE — connect credentials",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, -100]
    },
    {
      "parameters": {},
      "id": "8ba217d8-293c-4dd3-a8e2-2a459c43086e",
      "name": "Start a live transcription bot",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [180, 180]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"meetingLink\": \"https://replace-with-a-meeting-you-own\",\n  \"liveWebhookUrl\": \"https://YOUR_N8N_HOST/webhook/meetstream-live-turns-e94892de\"\n}",
        "options": {}
      },
      "id": "741dbe2c-aeb3-4b73-aaca-463df2949c2c",
      "name": "Configure meeting and production webhook",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [430, 180]
    },
    {
      "parameters": {
        "resource": "bot",
        "operation": "createBot",
        "meetingLink": "={{ $json.meetingLink }}",
        "botName": "MeetStream Live Summarizer",
        "videoRequired": false,
        "transcriptionMode": "live",
        "liveProvider": "deepgram_streaming",
        "liveWebhookUrl": "={{ $json.liveWebhookUrl }}",
        "transcriptionLanguage": "en",
        "providerOptions": "{}",
        "callbackUrl": "",
        "joinAt": "",
        "deduplicationKey": "",
        "idempotencyKey": "=n8n-live:{{ $execution.id }}",
        "customAttributes": "{\"source\":\"n8n_live_summary\"}"
      },
      "id": "c2a17110-f71d-4112-887e-9adb21590d22",
      "name": "Create live transcription bot",
      "type": "n8n-nodes-meetstream.meetStream",
      "typeVersion": 1,
      "position": [690, 180],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meetstream-live-turns-e94892de",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "d44e6fd9-729a-457a-919b-ce01474286c3",
      "name": "Receive live transcript chunks",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [180, 460],
      "webhookId": "e94892de-636f-4dfe-87d6-703ced25d12a"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nif (payload.end_of_turn !== true) return [];\nconst text = String(payload.utterance || payload.transcript || payload.new_text || '').trim();\nif (!payload.bot_id || !text) return [];\nreturn [{ json: { bot_id: String(payload.bot_id), speaker: payload.speakerName ?? 'Speaker', text, timestamp: payload.timestamp } }];"
      },
      "id": "6809e711-b6f8-4f37-b43f-885d3bc0513e",
      "name": "Keep final speaker turns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 460]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "responses": {
          "values": [
            {
              "role": "system",
              "type": "text",
              "content": "Summarize one finalized live meeting turn in one concise sentence. Preserve decisions, commitments, names, dates, and numbers. Do not invent context."
            },
            {
              "role": "user",
              "type": "text",
              "content": "=Speaker: {{ $json.speaker }}\nFinalized turn: {{ $json.text }}"
            }
          ]
        },
        "simplify": true,
        "options": { "temperature": 0.2 }
      },
      "id": "e96bc261-44f8-43dd-9c56-400040780e02",
      "name": "Summarize live turn",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [700, 460]
    }
  ],
  "connections": {
    "Start a live transcription bot": { "main": [[{ "node": "Configure meeting and production webhook", "type": "main", "index": 0 }]] },
    "Configure meeting and production webhook": { "main": [[{ "node": "Create live transcription bot", "type": "main", "index": 0 }]] },
    "Receive live transcript chunks": { "main": [[{ "node": "Keep final speaker turns", "type": "main", "index": 0 }]] },
    "Keep final speaker turns": { "main": [[{ "node": "Summarize live turn", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
